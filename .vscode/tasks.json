{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tauri Dev",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "tauri",
        "dev"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Cargo Format",
      "type": "shell",
      "command": "cargo",
      "args": [
        "fmt"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}