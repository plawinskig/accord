{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tauri Dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "tauri", "dev"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Cargo Format",
      "type": "shell",
      "command": "cargo",
      "args": ["fmt"],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Cargo Clippy",
      "type": "shell",
      "command": "cargo",
      "args": ["clippy", "--", "-D", "warnings"],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SQLx Create DB",
      "type": "shell",
      "command": "cargo",
      "args": ["sqlx", "database", "create"],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SQLx Migrate",
      "type": "shell",
      "command": "cargo",
      "args": ["sqlx", "migrate", "run"],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SQLx Prepare",
      "type": "shell",
      "command": "cargo",
      "args": ["sqlx", "prepare"],
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}