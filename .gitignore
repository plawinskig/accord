# =========================
# Configure Node.js and SvelteKit (Frontend)
# =========================
node_modules/
.svelte-kit/
build/
dist/
npm-debug.log*

# =========================
# Configure Rust and Tauri (Backend)
# =========================
src-tauri/target/
# Note: Keep Cargo.lock and Cargo.toml tracked by Git

# =========================
# Exclude the database (sqlx) and environment variables
# =========================
src-tauri/.env
src-tauri/dev.sqlite
src-tauri/dev.sqlite-wal
src-tauri/dev.sqlite-shm
# (The src-tauri/.sqlx folder created later in "offline mode" WILL be tracked)

# Zabezpieczenie przed przypadkowym dodaniem produkcyjnych baz danych
*.db
*.sqlite
*.sqlite-wal
*.sqlite-shm

# =========================
# Configure the OS and IDE (System and VS Code)
# =========================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json